{
    "name":  "dsh-ops-conventions",
    "version":  "0.2.1",
    "description":  "把「操作约定」在动手前确定性注入上下文：只在你这句话像要动手时才注入（闲聊零成本），同一会话同一约定版本只提醒一次，约定版本号（VERSION 文件）变化后自动再提醒一次；附带注入日志便于核对。用于解决「约定记了但干活时不提就不用」的问题。配合 OpenViking 使用：操作约定本身存在 OpenViking 技能里，本插件负责在动手前把它们提出来。",
    "keywords":  [
                     "dsh",
                     "dsh-plugin",
                     "deepseek-harness",
                     "conventions",
                     "prompt",
                     "instructions",
                     "workflow"
                 ],
    "license":  "MIT",
    "author":  "HeliosTangDev",
    "type":  "module",
    "main":  "index.mjs",
    "exports":  {
                    ".":  "./index.mjs",
                    "./rule":  "./rule.mjs",
                    "./package.json":  "./package.json"
                },
    "files":  [
                  "index.mjs",
                  "rule.mjs",
                  "install.mjs",
                  "cordis.patch.yml",
                  "skills",
                  "README.md",
                  "CHANGELOG.md",
                  "LICENSE"
              ],
    "scripts":  {
                    "test":  "node --test"
                },
    "repository":  {
                       "type":  "git",
                       "url":  "https://github.com/HeliosTangDev/dsh-ops-conventions.git"
                   },
    "homepage":  "https://github.com/HeliosTangDev/dsh-ops-conventions#readme",
    "bugs":  {
                 "url":  "https://github.com/HeliosTangDev/dsh-ops-conventions/issues"
             },
    "dsh":  {
                "bundle":  {
                               "patch":  "./cordis.patch.yml"
                           }
            },
    "peerDependencies":  {
                             "@deepseek-ai/dsh-llm":  "\u003e=0.1.0-rc.6 \u003c0.2.0-0 || \u003e=0.2.0-rc.1 \u003c0.2.1-0 || \u003e=0.2.1-rc.1 \u003c0.2.2-0 || \u003e=0.2.2-rc.1 \u003c0.3.0-0"
                         },
    "engines":  {
                    "node":  "^22.19.0 || \u003e=24"
                }
}
